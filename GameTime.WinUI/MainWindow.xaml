<Window
    x:Class="GameTime.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameTime">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="Back_Invoked"/>
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="AppTitleBar"
                  Title="GameTime"
                  IsBackButtonVisible="False"
                  BackRequested="AppTitleBar_BackRequested">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE7FC;"/>
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" Navigated="RootFrame_Navigated"/>
    </Grid>
</Window>
