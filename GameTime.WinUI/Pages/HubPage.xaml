<Page
    x:Class="GameTime.WinUI.Pages.HubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style x:Key="GameTile" TargetType="Button">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="320"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Bd" Background="#FF14301F" BorderBrush="#FF2E5A3E"
                              BorderThickness="2" CornerRadius="14">
                            <Grid.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.12"/>
                            </Grid.BackgroundTransition>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Bd.Background" Value="#FF1E4A2E"/>
                                            <Setter Target="Bd.BorderBrush" Value="Gold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Bd.Background" Value="#FF245838"/>
                                            <Setter Target="Bd.BorderBrush" Value="Gold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="84"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="TileBlurb" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFB8D8C4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>
    </Page.Resources>

    <Viewbox StretchDirection="DownOnly" Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🎮  GAME TIME" FontSize="40" FontWeight="Black" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Pick a game — play it yourself, or sit back and watch the computer play."
                       FontSize="15" Foreground="#FF8FB8A0" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <StackPanel x:Name="TilePanel" Orientation="Horizontal" HorizontalAlignment="Center" Padding="8,8,8,24">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="48"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Button Style="{StaticResource GameTile}" AutomationProperties.Name="Klondike" Click="Klondike_Click">
                    <StackPanel>
                        <TextBlock x:Name="KlondikeIcon" Text="♠️" Style="{StaticResource TileIcon}"/>
                        <TextBlock Text="Klondike" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="Classic solitaire. Draw 1 or 3, animated autoplay, full stats."
                                   Style="{StaticResource TileBlurb}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GameTile}" AutomationProperties.Name="FreeCell" Click="FreeCell_Click">
                    <StackPanel>
                        <TextBlock x:Name="FreeCellIcon" Text="🃏" Style="{StaticResource TileIcon}"/>
                        <TextBlock Text="FreeCell" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="Nearly every deal is winnable — watch the computer think its way out."
                                   Style="{StaticResource TileBlurb}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GameTile}" AutomationProperties.Name="Minesweeper" Click="Minesweeper_Click">
                    <StackPanel>
                        <TextBlock x:Name="MinesweeperIcon" Text="💣" Style="{StaticResource TileIcon}"/>
                        <TextBlock Text="Minesweeper" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="16×16, 40 mines. The auto-solver deduces, flags, and gambles."
                                   Style="{StaticResource TileBlurb}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GameTile}" AutomationProperties.Name="Maze Blaster" Click="Shooter_Click">
                    <StackPanel>
                        <TextBlock x:Name="ShooterIcon" Text="🔫" Style="{StaticResource TileIcon}"/>
                        <TextBlock Text="Maze Blaster" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="Watch-only: a bot roams a random 3D maze blasting creatures."
                                   Style="{StaticResource TileBlurb}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Viewbox>
</Page>
