<Page
    x:Class="GameTime.WinUI.Pages.ShooterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabelStyle}">
            <Setter Property="Foreground" Value="#FFB0B0C4"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}"/>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource GameButtonStyle}">
            <Setter Property="Background" Value="#FF3A3A52"/>
            <Setter Property="BorderBrush" Value="#FF6A6A92"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FF16161E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10" Background="Black" CornerRadius="10">
            <Grid>
                <canvas:CanvasControl x:Name="ViewCanvas" ClearColor="Black"
                                      CreateResources="ViewCanvas_CreateResources"
                                      Draw="ViewCanvas_Draw"/>
                <Border x:Name="ClearBanner" Style="{StaticResource BannerStyle}" Visibility="Collapsed">
                    <TextBlock Text="✅ MAZE CLEARED!" Style="{StaticResource BannerTextStyle}"
                               FontSize="52" Foreground="LawnGreen"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#FF1E1E2A" CornerRadius="10" Margin="0,10,10,10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock x:Name="HeaderIcon" Text="🔫" Style="{StaticResource SidebarTitleStyle}"/>
                        <TextBlock Text=" MAZE BLASTER" Style="{StaticResource SidebarTitleStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Press Start to watch." Style="{StaticResource StatusTextStyle}"/>

                    <Button x:Name="StartStopButton" Style="{StaticResource ActionButton}" Content="▶  Start" Click="StartStopButton_Click"/>
                    <Button x:Name="NewMazeButton" Style="{StaticResource ActionButton}" Content="🌀  New Maze" Click="NewMazeButton_Click"/>
                    <Button x:Name="ResetStatsButton" Style="{StaticResource ActionButton}" Content="🗑  Reset Stats"
                            Background="#FF5A2B2B" BorderBrush="#FFA85050" Click="ResetStatsButton_Click"/>

                    <TextBlock Text="SPEED" Style="{StaticResource StatLabel}" Margin="0,14,0,0"/>
                    <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" StepFrequency="1"/>

                    <Rectangle Height="1" Margin="0,14,0,4" Fill="#FF34344A"/>

                    <TextBlock Text="TARGETS REMAINING" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TargetsLeftText" Text="0" Style="{StaticResource StatValue}" Foreground="#FFFF8A8A"/>

                    <TextBlock Text="MAZES CLEARED" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="MazesClearedText" Text="0" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="TARGETS DESTROYED" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="KillsText" Text="0" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="SHOTS FIRED" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="ShotsText" Text="0" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="ACCURACY" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="AccuracyText" Text="—" Style="{StaticResource StatValue}" Foreground="#FF9A9AE0"/>

                    <TextBlock Text="THIS MAZE" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="MazeTimeText" Text="00:00" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="FASTEST CLEAR" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="FastestClearText" Text="—" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
