<Page
    x:Class="GameTime.WinUI.Pages.FreeCellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabelStyle}">
            <Setter Property="Foreground" Value="#FFB8C8E0"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}"/>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource GameButtonStyle}">
            <Setter Property="Background" Value="#FF2A4A7A"/>
            <Setter Property="BorderBrush" Value="#FF4A7AC0"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FF1A2B4A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10" CornerRadius="10">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#FF2A4570" Offset="0"/>
                    <GradientStop Color="#FF16233E" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Grid>
                <Canvas x:Name="BoardCanvas"/>
                <Border x:Name="WinBanner" Style="{StaticResource BannerStyle}" Visibility="Collapsed">
                    <TextBlock Text="🏆 YOU WIN! 🏆" Style="{StaticResource BannerTextStyle}"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#FF14213A" CornerRadius="10" Margin="0,10,10,10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock x:Name="HeaderIcon" Text="🃏" Style="{StaticResource SidebarTitleStyle}"/>
                        <TextBlock Text=" FREECELL" Style="{StaticResource SidebarTitleStyle}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Stats.Status, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"/>

                    <Button x:Name="NewGameButton" Style="{StaticResource ActionButton}" Content="🂠  New Game" Click="NewGameButton_Click"/>
                    <Button x:Name="AutoPlayButton" Style="{StaticResource ActionButton}" Content="▶  Auto Play" Click="AutoPlayButton_Click"/>
                    <Button x:Name="HintButton" Style="{StaticResource ActionButton}" Content="💡  Hint Move" Click="HintButton_Click"/>
                    <Button x:Name="ResetStatsButton" Style="{StaticResource ActionButton}" Content="🗑  Reset Stats"
                            Background="#FF5A2B2B" BorderBrush="#FFA85050" Click="ResetStatsButton_Click"/>

                    <TextBlock Text="SPEED" Style="{StaticResource StatLabel}" Margin="0,14,0,0"/>
                    <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" StepFrequency="1"/>

                    <Rectangle Height="1" Margin="0,14,0,4" Fill="#FF2B3A5A"/>

                    <TextBlock Text="GAMES PLAYED" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.GamesPlayed, Mode=OneWay}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="GAMES WON" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.GamesWon, Mode=OneWay}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="WIN RATE" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.WinRate, Mode=OneWay}" Style="{StaticResource StatValue}" Foreground="#FF6FA0E0"/>

                    <TextBlock Text="CURRENT STREAK" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.CurrentStreak, Mode=OneWay}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="BEST STREAK" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.BestStreak, Mode=OneWay}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="MOVES (THIS GAME)" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.CurrentMoves, Mode=OneWay}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="TOTAL MOVES" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.TotalMoves, Mode=OneWay}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="CARDS ON FOUNDATION" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.CardsToFoundation, Mode=OneWay}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="FASTEST WIN" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{x:Bind Stats.FastestWinText, Mode=OneWay}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
