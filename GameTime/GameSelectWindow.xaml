<Window x:Class="GameTime.GameSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameTime — Choose a Game" Height="520" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#FF0E1B14">
    <Window.Resources>
        <Style x:Key="GameCard" TargetType="Button">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="320"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF14301F" CornerRadius="14"
                                BorderBrush="#FF2E5A3E" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E4A2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Gold"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="84"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="CardBlurb" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFB8D8C4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>
    </Window.Resources>

    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="🎮  GAME TIME" FontSize="40" FontWeight="Black" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock Text="Pick a game — play it yourself, or sit back and watch the computer play."
                   FontSize="15" Foreground="#FF8FB8A0" HorizontalAlignment="Center" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource GameCard}" Click="Solitaire_Click">
                <StackPanel>
                    <TextBlock Text="♠️" Style="{StaticResource CardIcon}"/>
                    <TextBlock Text="Klondike" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Classic solitaire. Draw 1 or 3, animated autoplay, full stats."
                               Style="{StaticResource CardBlurb}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GameCard}" Click="FreeCell_Click">
                <StackPanel>
                    <TextBlock Text="🃏" Style="{StaticResource CardIcon}"/>
                    <TextBlock Text="FreeCell" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Nearly every deal is winnable — watch the computer think its way out."
                               Style="{StaticResource CardBlurb}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GameCard}" Click="Minesweeper_Click">
                <StackPanel>
                    <TextBlock Text="💣" Style="{StaticResource CardIcon}"/>
                    <TextBlock Text="Minesweeper" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="16×16, 40 mines. The auto-solver deduces, flags, and gambles."
                               Style="{StaticResource CardBlurb}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GameCard}" Click="Shooter_Click">
                <StackPanel>
                    <TextBlock Text="🔫" Style="{StaticResource CardIcon}"/>
                    <TextBlock Text="Maze Blaster" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Watch-only: a bot roams a random 3D maze blasting creatures."
                               Style="{StaticResource CardBlurb}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
