<Window x:Class="GameTime.FreeCellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameTime FreeCell" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A2B4A">
    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB8C8E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF2A4A7A"/>
            <Setter Property="BorderBrush" Value="#FF4A7AC0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A5F9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#FF2A4570" Offset="0"/>
                    <GradientStop Color="#FF16233E" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Grid>
                <Canvas x:Name="BoardCanvas" ClipToBounds="True"/>
                <TextBlock x:Name="WinBanner" Text="🏆 YOU WIN! 🏆" FontSize="64" FontWeight="Black"
                           Foreground="Gold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="Black" Opacity="0.9"/>
                    </TextBlock.Effect>
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="WinBannerScale" ScaleX="0" ScaleY="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#FF14213A" CornerRadius="10" Margin="0,10,10,10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🃏 FREECELL" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Status}" Foreground="#FFFFD766" FontSize="14"
                               FontStyle="Italic" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button x:Name="NewGameButton" Style="{StaticResource ActionButton}" Content="🂠  New Game" Click="NewGameButton_Click"/>
                    <Button x:Name="AutoPlayButton" Style="{StaticResource ActionButton}" Content="▶  Auto Play" Click="AutoPlayButton_Click"/>
                    <Button x:Name="HintButton" Style="{StaticResource ActionButton}" Content="💡  Hint Move" Click="HintButton_Click"/>
                    <Button x:Name="ResetStatsButton" Style="{StaticResource ActionButton}" Content="🗑  Reset Stats"
                            Background="#FF5A2B2B" BorderBrush="#FFA85050" Click="ResetStatsButton_Click"/>

                    <TextBlock Text="SPEED" Style="{StaticResource StatLabel}" Margin="0,14,0,0"/>
                    <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True"/>

                    <Separator Margin="0,14,0,4" Background="#FF2B3A5A"/>

                    <TextBlock Text="GAMES PLAYED" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding GamesPlayed}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="GAMES WON" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding GamesWon}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="WIN RATE" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding WinRate}" Style="{StaticResource StatValue}" Foreground="#FF6FA0E0"/>

                    <TextBlock Text="CURRENT STREAK" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding CurrentStreak}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="BEST STREAK" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding BestStreak}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="MOVES (THIS GAME)" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding CurrentMoves}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="TOTAL MOVES" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding TotalMoves}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="CARDS ON FOUNDATION" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding CardsToFoundation}" Style="{StaticResource StatValue}"/>

                    <TextBlock Text="FASTEST WIN" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding FastestWinText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
